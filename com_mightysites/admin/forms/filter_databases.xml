<?xml version="1.0" encoding="utf-8"?>
<form>
	<fields name="filter">
		<field
			name="search"
			type="text"
			inputmode="search"
			label="COM_MIGHTYSITES_FILTER_SEARCH_LABEL"
			description="COM_MIGHTYSITES_FILTER_SEARCH_DESC"
			hint="JSEARCH_FILTER"
		/>
		<field
			name="type"
			type="list"
			label="COM_MIGHTYSITES_FILTER_TYPE"
			description="COM_MIGHTYSITES_FILTER_TYPE_DESC"
			onchange="this.form.submit();"
			>
			<option value="">JOPTION_SELECT_PUBLISHED</option>
			<option value="1">COM_MIGHTYSITES_DATABASE_ORIGIN_SITE</option>
			<option value="2">COM_MIGHTYSITES_DATABASE_ORIGIN_DATABASE</option>
		</field>
	</fields>
	<fields name="list">
		<field
			name="limit"
			type="limitbox"
			label="COM_MIGHTYSITES_LIST_LIMIT"
			default="25"
			class="input-mini input-small"
		/>
	</fields>
</form>
